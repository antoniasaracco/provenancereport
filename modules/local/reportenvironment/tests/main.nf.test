nextflow_process {

    name "Test Process REPORTENVIRONMENT"
    script "../main.nf"
    process "REPORTENVIRONMENT"

    tag "modules"
    tag "modules_local"
    tag "reportenvironment"

    test("collect report runtime environment - R-only container") {

        when {
            process {
                """
                input[0] = [
                    'QUARTO_NOTEBOOK',
                    'docker',
                    'community.wave.seqera.io/library/r-base_quarto_r-rmarkdown_r-conflicted_pruned:ad3e9e15399e1f89',
                    file("${projectDir}/modules/local/reportenvironment/tests/assets/package_calls.inspect.json", checkIfExists: true),
                    file("${projectDir}/modules/local/reportenvironment/tests/assets/notebook_versions_empty.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def runtime_table = path(process.out.multiqc_table.first()).text
            def normalized_runtime_table = runtime_table
                .replaceAll(/(?m)^Container engine\t.*$/, 'Container engine\t<ENGINE>')
                .replaceAll(/(?m)^Python\t.*$/, 'Python\t<VERSION>')
            def r_session = path(process.out.multiqc_r_session.first()).text
            def normalized_r_session = r_session.replaceAll(
                /(?s)(<pre[^>]*>\n).*?(\n  <\/pre>)/,
                '$1  <R_SESSION_INFO>$2'
            )
            def versions = path(process.out.versions.first()).text
            assertAll(
                { assert process.success },
                { assert runtime_table.contains('Runtime source process\tQUARTO_NOTEBOOK') },
                { assert runtime_table.contains('Runtime backend\tdocker') },
                { assert runtime_table.contains('Runtime reference\tcommunity.wave.seqera.io/library/r-base_quarto_r-rmarkdown_r-conflicted_pruned:ad3e9e15399e1f89') },
                { assert runtime_table.contains('Quarto engine\tknitr') },
                { assert runtime_table.contains('Python\tNot available') },
                { assert runtime_table.contains('Package version source\tQuarto inspection fallback') },
                { assert r_session.contains('This describes a separate R process in the report runtime') },
                { assert versions.contains('"R": "') },
                { assert versions.contains('"knitr":') },
                { assert versions.contains('"tidyverse":') },
                { assert versions.contains('"conflicted":') },
                { assert snapshot(normalized_runtime_table, normalized_r_session).match() },
            )
        }
    }

    test("collect report runtime environment - conda") {

        when {
            process {
                """
                input[0] = [
                    'QUARTONOTEBOOK',
                    'conda',
                    "${projectDir}/modules/local/reportenvironment/tests/assets/environment.yml",
                    file("${projectDir}/modules/local/reportenvironment/tests/assets/package_calls.inspect.json", checkIfExists: true),
                    file("${projectDir}/modules/local/reportenvironment/tests/assets/notebook_versions.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def runtime_table = path(process.out.multiqc_table.first()).text
            def normalized_runtime_table = runtime_table
                .replace("${projectDir}", '<PROJECT_DIR>')
                .replaceAll(/(?m)^Container engine\t.*$/, 'Container engine\t<ENGINE>')
                .replaceAll(/(?m)^Python\t.*$/, 'Python\t<VERSION>')
            def r_session = path(process.out.multiqc_r_session.first()).text
            def normalized_r_session = r_session.replaceAll(
                /(?s)(<pre[^>]*>\n).*?(\n  <\/pre>)/,
                '$1  <R_SESSION_INFO>$2'
            )
            def versions = path(process.out.versions.first()).text
            assertAll(
                { assert process.success },
                { assert runtime_table.contains('Runtime source process\tQUARTONOTEBOOK') },
                { assert runtime_table.contains('Runtime backend\tconda') },
                { assert runtime_table.contains("Runtime reference\t${projectDir}/modules/local/reportenvironment/tests/assets/environment.yml") },
                { assert runtime_table.contains('Quarto engine\tknitr') },
                { assert runtime_table.contains('Package version source\tNotebook versions.csv (authoritative)') },
                { assert r_session.contains('This describes a separate R process in the report runtime') },
                { assert versions.contains('"knitr": "from-notebook"') },
                { assert versions.contains('"notebook-tool": "9.1"') },
                { assert !versions.contains('"tidyverse":') },
                { assert snapshot(normalized_runtime_table, normalized_r_session).match() },
            )
        }
    }

    test("collect report runtime environment - none") {

        when {
            process {
                """
                input[0] = [
                    'QUARTONOTEBOOK',
                    'none',
                    'Not configured',
                    file("${projectDir}/modules/local/reportenvironment/tests/assets/package_calls.inspect.json", checkIfExists: true),
                    file("${projectDir}/modules/local/reportenvironment/tests/assets/notebook_versions.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def runtime_table = path(process.out.multiqc_table.first()).text
            def normalized_runtime_table = runtime_table
                .replaceAll(/(?m)^Container engine\t.*$/, 'Container engine\t<ENGINE>')
                .replaceAll(/(?m)^Python\t.*$/, 'Python\t<VERSION>')
            def r_session = path(process.out.multiqc_r_session.first()).text
            def normalized_r_session = r_session.replaceAll(
                /(?s)(<pre[^>]*>\n).*?(\n  <\/pre>)/,
                '$1  <R_SESSION_INFO>$2'
            )
            def versions = path(process.out.versions.first()).text
            assertAll(
                { assert process.success },
                { assert runtime_table.contains('Runtime source process\tQUARTONOTEBOOK') },
                { assert runtime_table.contains('Runtime backend\tnone') },
                { assert runtime_table.contains('Runtime reference\tNot configured') },
                { assert runtime_table.contains('Quarto engine\tknitr') },
                { assert runtime_table.contains('Package version source\tNotebook versions.csv (authoritative)') },
                { assert r_session.contains('This describes a separate R process in the report runtime') },
                { assert versions.contains('"knitr": "from-notebook"') },
                { assert versions.contains('"notebook-tool": "9.1"') },
                { assert !versions.contains('"tidyverse":') },
                { assert snapshot(normalized_runtime_table, normalized_r_session).match() },
            )
        }
    }
}
