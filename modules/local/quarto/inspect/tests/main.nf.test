nextflow_process {

    name "Test Process QUARTO_INSPECT"
    script "../main.nf"
    process "QUARTO_INSPECT"

    tag "modules"
    tag "modules_local"
    tag "quarto"
    tag "quarto/inspect"

    test("inspect R Quarto document") {

        when {
            process {
                """
                input[0] = [
                    [ id:'provenance_report' ],
                    file("${projectDir}/assets/provenance_report.qmd", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def inspection = new groovy.json.JsonSlurper().parse(path(process.out.inspection[0][1]))
            assertAll(
                { assert process.success },
                { assert inspection.engines == ['knitr'] },
                { assert inspection.quarto.version },
                { assert inspection.fileInformation.keySet().any { it.endsWith('provenance_report.qmd') } },
                { assert snapshot(process.out.versions_quarto).match() },
            )
        }
    }

}
