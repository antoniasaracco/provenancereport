params {
    input = "${projectDir}/tests/assets/samplesheet_rds.csv"
    notebook = "${projectDir}/tests/assets/external_rds_report.qmd"
}

process {
    withName: '.*QUARTO_NOTEBOOK.*' {
        container = 'community.wave.seqera.io/library/bioconductor-biobase_bioconductor-biocgenerics_bioconductor-delayedarray_bioconductor-genomicranges_pruned:7163c0bd27362bdf'
        conda = "${projectDir}/tests/assets/environment.yml"
    }
}
